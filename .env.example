# Copy to .env and set at least TESLACAM_PATH.

# The folder your Glovebox uploads to: the one holding RecentClips,
# SavedClips and SentryClips (a parent folder also works).
TESLACAM_PATH=/path/to/TeslaCam

# Web port: open http://<this machine>:5500
PORT=5500

# Kept originals, app data and imports. Relative paths are next to compose.yaml.
KEEP_PATH=./keep
DATA_PATH=./data
IMPORT_PATH=./imports

# The user the app runs as; it must be able to read TESLACAM_PATH.
# Unraid: 99 / 100. Most Linux systems: 1000 / 1000 (run `id` to check).
PUID=1000
PGID=1000

TZ=UTC

# Minutes of Recent footage join one drive until the car stops recording
# this long (seconds).
DRIVE_GAP_SECONDS=300

# Pin a release instead of following the latest, e.g. VERSION=1.0.0
VERSION=latest
